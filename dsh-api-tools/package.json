{
  "name": "@deepseek-ai/dsh-api-tools",
  "description": "API tools plugin for DeepSeek Harness: turn third-party HTTP APIs into Agent-callable tools (data query / control commands) with CRUD, parameter mapping, authentication, and draft testing from the Settings page",
  "version": "1.0.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "test": "node tests/api-tools-regression.test.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.5",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.5"
  }
}
