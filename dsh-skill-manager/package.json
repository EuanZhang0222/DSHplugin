{
  "name": "dsh-skill-manager",
  "version": "1.0.0",
  "description": "DSH 技能管理器：自定义技能、批量导入导出、正文与脚本、@技能名互调及接口/数据库/SQL 引用，配置后立即生效并持久化到 ~/.dsh/skills/",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
